---
import type { SeoProps } from '@utils/seo';
import {
  absoluteUrl,
  buildOrganizationSchema,
  buildWebSiteSchema,
  mergeJsonLd,
} from '@utils/seo';
import { siteConfig } from '@config/site';
import { integrationsConfig } from '@config/integrations';

interface Props extends SeoProps {
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description = siteConfig.description,
  canonical,
  robots,
  ogImage = siteConfig.defaultOgImage,
  ogImageAlt,
  ogImageWidth = siteConfig.defaultOgImageWidth,
  ogImageHeight = siteConfig.defaultOgImageHeight,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  breadcrumbs,
  article,
} = Astro.props;

const pageUrl = canonical ? absoluteUrl(canonical) : Astro.url.href.replace(/\/index\.html$/, '/');
const imageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
const imageAlt = ogImageAlt ?? title;
const robotsContent = noindex ? 'noindex, nofollow' : robots ?? 'index, follow';

const schema = mergeJsonLd(
  buildOrganizationSchema(),
  buildWebSiteSchema(),
  jsonLd,
  breadcrumbs?.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.url.startsWith('http') ? item.url : absoluteUrl(item.url),
        })),
      }
    : undefined,
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Sofia+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap"
  rel="stylesheet"
/>
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={pageUrl} />
<meta name="language" content={siteConfig.language} />

<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
{
  ogType === 'article' && article?.publishedTime && (
    <meta property="article:published_time" content={article.publishedTime} />
  )
}
{
  ogType === 'article' && article?.modifiedTime && (
    <meta property="article:modified_time" content={article.modifiedTime} />
  )
}
{
  ogType === 'article' && article?.author && (
    <meta property="article:author" content={article.author} />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link
  rel="icon"
  type="image/svg+xml"
  href="/bg/favicon.svg"
  media="(prefers-color-scheme: light)"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href="/bg/favicon-dark.svg"
  media="(prefers-color-scheme: dark)"
/>
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="/bg/favicon-32x32.png"
  media="(prefers-color-scheme: light)"
/>
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="/bg/favicon-dark-32x32.png"
  media="(prefers-color-scheme: dark)"
/>
<link rel="apple-touch-icon" sizes="180x180" href="/bg/apple-touch-icon.png" />
<link rel="manifest" href="/bg/site.webmanifest" />

<script is:inline>
  (function () {
    const base = '/bg';
    const icons = {
      light: `${base}/favicon.svg`,
      dark: `${base}/favicon-dark.svg`,
    };

    function getTheme() {
      const stored = localStorage.getItem('weberest-theme');
      if (stored === 'light' || stored === 'dark') return stored;
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }

    function syncFavicon(useDomTheme) {
      const theme = useDomTheme
        ? document.documentElement.getAttribute('data-theme') === 'light'
          ? 'light'
          : 'dark'
        : getTheme();

      let link = document.querySelector('link[data-dynamic-favicon]');
      if (!link) {
        link = document.createElement('link');
        link.rel = 'icon';
        link.type = 'image/svg+xml';
        link.setAttribute('data-dynamic-favicon', '');
        document.head.appendChild(link);
      }

      link.href = icons[theme];
    }

    syncFavicon(false);

    new MutationObserver(() => syncFavicon(true)).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>
<meta name="theme-color" content="#300290" />

{
  integrationsConfig.googleSiteVerification && (
    <meta name="google-site-verification" content={integrationsConfig.googleSiteVerification} />
  )
}

<script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : schema)} />
