---
import type { SeoProps } from '@utils/seo';
import {
  absoluteUrl,
  buildOrganizationSchema,
  buildWebSiteSchema,
  mergeJsonLd,
} from '@utils/seo';
import { siteConfig } from '@config/site';
import { integrationsConfig } from '@config/integrations';

interface Props extends SeoProps {
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description = siteConfig.description,
  canonical,
  robots,
  ogImage = siteConfig.defaultOgImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  breadcrumbs,
  article,
} = Astro.props;

const pageUrl = canonical ? absoluteUrl(canonical) : Astro.url.href.replace(/\/index\.html$/, '/');
const imageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
const robotsContent = noindex ? 'noindex, nofollow' : robots ?? 'index, follow';

const schema = mergeJsonLd(
  buildOrganizationSchema(),
  buildWebSiteSchema(),
  jsonLd,
  breadcrumbs?.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.url.startsWith('http') ? item.url : absoluteUrl(item.url),
        })),
      }
    : undefined,
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Sofia+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap"
  rel="stylesheet"
/>
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={pageUrl} />
<meta name="language" content={siteConfig.language} />

<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={imageUrl} />
{
  ogType === 'article' && article?.publishedTime && (
    <meta property="article:published_time" content={article.publishedTime} />
  )
}
{
  ogType === 'article' && article?.modifiedTime && (
    <meta property="article:modified_time" content={article.modifiedTime} />
  )
}
{
  ogType === 'article' && article?.author && (
    <meta property="article:author" content={article.author} />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="icon" type="image/svg+xml" href="/bg/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/bg/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/bg/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/bg/apple-touch-icon.png" />
<link rel="manifest" href="/bg/site.webmanifest" />
<meta name="theme-color" content="#300290" />

{
  integrationsConfig.googleSiteVerification && (
    <meta name="google-site-verification" content={integrationsConfig.googleSiteVerification} />
  )
}

<script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : schema)} />
