---
import type { SocialLink } from '@config/site';

interface Props {
  network: SocialLink['id'];
}

const { network } = Astro.props;
---

{
  network === 'facebook' && (
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" class="social-icon social-icon--facebook">
      <path
        fill="currentColor"
        d="M9.101 23.691v-7.98H6.127v-3.667h3.004v-3.401c0-3.024 1.892-4.665 4.661-4.665 1.053 0 2.15.085 3.002.085v3.168H15.71c-1.481 0-1.688.817-1.688 1.835v2.313h3.395l-.587 3.667h-2.855v7.98H9.101z"
      />
    </svg>
  )
}
{
  network === 'youtube' && (
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" class="social-icon social-icon--youtube">
      <path
        fill="currentColor"
        d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
      />
    </svg>
  )
}
