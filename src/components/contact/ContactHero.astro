---
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import heroVideo from '../../assets/videos/weberest-video.mp4?url';
import { contactHero } from '@config/contact';

interface Props {
  breadcrumbs: { name: string; url: string }[];
}

const { breadcrumbs } = Astro.props;
const heroPoster = `${import.meta.env.BASE_URL}images/video-posters/weberest-video-poster.jpg`;
---

<header class="contact-hero">
  <div class="contact-hero__media" aria-hidden="true">
    <video autoplay muted loop playsinline preload="auto" poster={heroPoster} class="contact-hero__video" data-contact-video>
      <source src={heroVideo} type="video/mp4" />
    </video>
    <div class="contact-hero__overlay"></div>
    <div class="contact-hero__noise"></div>
  </div>

  <div class="contact-hero__inner">
    <div class="contact-hero__crumb">
      <Breadcrumbs items={breadcrumbs} variant="inverse" />
    </div>

    <div class="contact-hero__content" data-reveal="left">
      <span class="section-eyebrow">{contactHero.eyebrow}</span>
      <h1 class="contact-hero__title">{contactHero.title}</h1>
      <p class="contact-hero__lead">{contactHero.lead}</p>
      <div class="contact-hero__actions">
        <a href={`/bg${contactHero.primaryHref}`} class="btn btn--primary btn--glow">
          {contactHero.primaryLabel}
        </a>
        <a href={`/bg${contactHero.secondaryHref}`} class="btn btn--secondary">
          {contactHero.secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const video = document.querySelector('[data-contact-video]') as HTMLVideoElement | null;
  if (video) {
    video.muted = true;
    video.defaultMuted = true;
    video.play().catch(() => {});
  }
</script>
