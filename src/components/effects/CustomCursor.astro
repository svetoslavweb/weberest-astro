<div class="custom-cursor is-visible" data-custom-cursor aria-hidden="true"></div>

<script is:inline>
  (function () {
    var cursor = document.querySelector('[data-custom-cursor]');
    if (!cursor) return;

    var canUseCustomCursor = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (!canUseCustomCursor) {
      cursor.remove();
      return;
    }

    document.documentElement.classList.add('has-custom-cursor');

    var targetX = window.innerWidth / 2;
    var targetY = window.innerHeight / 2;
    var currentX = targetX;
    var currentY = targetY;

    function show() {
      cursor.classList.add('is-visible');
    }

    function hide() {
      cursor.classList.remove('is-visible');
    }

    function moveTo(x, y) {
      targetX = x;
      targetY = y;
      show();
    }

    window.addEventListener(
      'mousemove',
      function (event) {
        moveTo(event.clientX, event.clientY);
      },
      { passive: true },
    );

    window.addEventListener('mouseout', function (event) {
      if (!event.relatedTarget && !event.toElement) hide();
    });

    window.addEventListener('mouseover', show);

    show();
    cursor.style.transform = 'translate3d(' + targetX + 'px, ' + targetY + 'px, 0)';

    function animate() {
      currentX += (targetX - currentX) * 0.22;
      currentY += (targetY - currentY) * 0.22;
      cursor.style.transform = 'translate3d(' + currentX + 'px, ' + currentY + 'px, 0)';
      requestAnimationFrame(animate);
    }

    animate();
  })();
</script>
