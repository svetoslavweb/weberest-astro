---
import { localPresence } from '@config/local-presence';
import { starFill } from '@utils/local-rating';

interface Props {
  href?: string;
  class?: string;
}

const { href = '#local-presence', class: className } = Astro.props;
const { name, category, rating, reviewCount } = localPresence;
const link = href.startsWith('#') ? href : `/bg${href}`.replace(/\/bg\/bg/, '/bg');
---

<a href={link} class:list={['local-rating-badge', className]} aria-label={`${rating} от 5 звезди — ${reviewCount} отзива в Google. Вижте локалното ни представяне.`}>
  <span class="local-rating-badge__google" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
      <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" />
      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
    </svg>
    Google
  </span>
  <span class="local-rating-badge__body">
    <span class="local-rating-badge__name">{name}</span>
    <span class="local-rating-badge__category">{category}</span>
    <span class="local-rating-badge__score-row">
      <span class="local-rating-badge__value">{rating.toFixed(1)}</span>
      <span class="local-rating-badge__stars" aria-hidden="true">
        {
          Array.from({ length: 5 }, (_, index) => (
            <span class:list={['local-rating-badge__star', `local-rating-badge__star--${starFill(index, rating)}`]}>
              <svg viewBox="0 0 24 24" focusable="false">
                <path fill="currentColor" d="M12 2l2.9 6.02 6.64.58-5.02 4.36 1.52 6.48L12 16.9l-6.04 3.58 1.52-6.48-5.02-4.36 6.64-.58L12 2z" />
              </svg>
            </span>
          ))
        }
      </span>
    </span>
    <span class="local-rating-badge__reviews">{reviewCount} отзива в Google</span>
  </span>
  <span class="local-rating-badge__arrow" aria-hidden="true">↓</span>
</a>
