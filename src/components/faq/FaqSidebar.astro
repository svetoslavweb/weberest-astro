---
import QuoteForm from '@components/forms/QuoteForm.astro';
import { faqSidebarServices } from '@config/faq-page';
---

<aside class="faq-sidebar content-page__sidebar" aria-label="Услуги и калкулатор">
  <section class="faq-sidebar__services">
    <div class="faq-sidebar__services-head">
      <span class="section-eyebrow">Услуги</span>
      <h2 class="faq-sidebar__title">Как можем да ви помогнем</h2>
    </div>

    <ul class="faq-sidebar__list">
      {
        faqSidebarServices.map((item) => (
          <li>
            <a
              href={`/bg${item.href}`}
              class:list={['faq-sidebar__link', item.featured && 'faq-sidebar__link--featured']}
            >
              <span class="faq-sidebar__link-label">{item.label}</span>
              {item.badge && <span class="faq-sidebar__badge">{item.badge}</span>}
              <span class="faq-sidebar__link-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    fill="currentColor"
                    d="M9.29 6.71a1 1 0 011.42 0L15.7 12l-4.99 5.29a1 1 0 01-1.42-1.42L12.59 12 9.29 8.71a1 1 0 010-1.42z"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="faq-sidebar__calculator" id="quote-form" aria-label="Уеб Сайт Калкулатор">
    <div class="faq-sidebar__calculator-head">
      <span class="faq-sidebar__calculator-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M7 2h10a2 2 0 012 2v16a2 2 0 01-2 2H7a2 2 0 01-2-2V4a2 2 0 012-2zm0 4v3h10V6H7zm0 5v2h2v-2H7zm3 0v2h2v-2h-2zm3 0v2h2v-2h-2zm3 0v2h2v-2h-2zM7 16v2h2v-2H7zm3 0v2h2v-2h-2zm3 0v2h2v-2h-2zm3 0v2h2v-2h-2zM7 19v2h10v-2H7z"
          />
        </svg>
      </span>
      <div>
        <h2 class="faq-sidebar__title">Уеб Сайт Калкулатор</h2>
        <p class="faq-sidebar__calculator-lead">Получете безплатна оферта за вашия проект.</p>
      </div>
    </div>

    <QuoteForm compact showIntro={false} />
  </section>
</aside>
