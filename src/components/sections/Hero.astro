---
import heroVideo from '../../assets/videos/weberest-video.mp4?url';
import QuoteForm from '@components/forms/QuoteForm.astro';

interface Props {
  title: string;
  subtitle?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title,
  subtitle,
  primaryHref = '/it-konsultacia/#contact-form',
  primaryLabel = 'Безплатна консултация',
  secondaryHref = '/website-klienti/',
  secondaryLabel = 'Вижте портфолиото',
} = Astro.props;

const primaryLink = primaryHref.startsWith('#') ? primaryHref : `/bg${primaryHref}`;
---

<section class="hero hero--pop hero--video" id="hero">
  <div class="hero__video" aria-hidden="true">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="hero__video-media"
      data-hero-video
    >
      <source src={heroVideo} type="video/mp4" />
    </video>
    <div class="hero__video-overlay"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__content" data-reveal="left">
      <span class="section-eyebrow">Weberest · Digital Studio · Русе</span>
      <h1 class="hero__title">{title}</h1>
      {subtitle && <p class="hero__lead">{subtitle}</p>}
      <div class="hero__actions">
        <a href={primaryLink} class="btn btn--primary btn--glow">{primaryLabel}</a>
        <a href={`/bg${secondaryHref}`} class="btn btn--secondary">{secondaryLabel}</a>
      </div>
    </div>

    <aside class="hero__panel hero__panel--quote" data-reveal="rotate" data-reveal-delay="2" id="quote-form" aria-label="Уеб сайт калкулатор">
      <div class="hero__panel-badge">
        <span class="hero__panel-badge-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path
              fill="currentColor"
              d="M7 2h10a2 2 0 012 2v16a2 2 0 01-2 2H7a2 2 0 01-2-2V4a2 2 0 012-2zm0 4v3h10V6H7zm0 5v2h2v-2H7zm3 0v2h2v-2h-2zm3 0v2h2v-2h-2zm3 0v2h2v-2h-2zM7 16v2h2v-2H7zm3 0v2h2v-2h-2zm3 0v2h2v-2h-2zm3 0v2h2v-2h-2zM7 19v2h10v-2H7z"
            />
          </svg>
        </span>
        Уеб Сайт Калкулатор
      </div>
      <QuoteForm hero compact showIntro={false} />
    </aside>
  </div>
</section>

<script>
  const video = document.querySelector('[data-hero-video]') as HTMLVideoElement | null;
  if (video) {
    video.muted = true;
    video.defaultMuted = true;
    video.play().catch(() => {
      /* autoplay blocked until user interaction */
    });
  }
</script>
