---
interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
  class?: string;
}

const {
  title = 'Имате идея за сайт? Нека я превърнем в работещ проект.',
  text = 'Разкажете ни какво искате да постигнете и ще ви насочим към правилното решение.',
  href = '/zapitanie/',
  label = 'Калкулирай цена',
  class: className,
} = Astro.props;
---

<section class:list={['cta-banner', className]} data-reveal="scale">
  <div class="cta-banner__inner">
    <div>
      <h2 class="cta-banner__title">{title}</h2>
      <p class="cta-banner__text">{text}</p>
    </div>
    <a href={`/bg${href}`} class="btn btn--primary">{label}</a>
  </div>
</section>
